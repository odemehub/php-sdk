{
    "name": "odemehub/php-sdk",
    "description": "ödemehub ödeme geçidi için PHP istemcisi.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://dev.odemehub.com/",
    "support": {
        "docs": "https://dev.odemehub.com/",
        "source": "https://github.com/odemehub/php-sdk",
        "issues": "https://github.com/odemehub/php-sdk/issues"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "Gurmehub\\Odemehub\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
